  "verification_fields": {
    "government_id": {
      "field_name": "idFront",
      "type": "Json",
      "status": "optional",
      "description": "Front side of government ID document"
    },
    "government_id_back": {
      "field_name": "idBack",
      "type": "Json",
      "status": "optional",
      "description": "Back side of government ID document"
    },
    "captain_license": {
      "field_name": "captainLicense",
      "type": "Json",
      "status": "optional",
      "description": "Captain/Skipper license document"
    },
    "boat_registration": {
      "field_name": "boatRegistration",
      "type": "Json",
      "status": "optional",
      "description": "Boat registration document"
    },
    "fishing_license": {
      "field_name": "fishingLicense",
      "type": "Json",
      "status": "optional",
      "description": "Fishing license document"
    },
    "bank_statement": {
      "field_name": "bankStatement",
      "type": "Json",
      "status": "optional",
      "description": "Bank statement for verification"
    },
    "additional_documents": {
      "field_name": "additional",
      "type": "Json",
      "status": "optional",
      "description": "Array of additional documents"
    },
    "banking_info": {
      "fields": [
        "bankAccountHolder",
        "bankAccountNumber",
        "bankBranch",
        "bankName",
        "bankSwiftCode"
      ],
      "type": "String",
      "status": "optional",
      "description": "Banking information for payouts"
    },
    "verification_status_enum": {
      "field_name": "status",
      "type": "enum VerificationStatus",
      "values": ["PENDING", "APPROVED", "REJECTED"],
      "default": "PENDING",
      "description": "Overall verification status"
    }
  },
  "document_upload_structure": {
    "uploaded_document_format": {
      "key": "string (Vercel Blob storage key)",
      "url": "string (public URL)",
      "name": "string (original filename)",
      "updatedAt": "string (ISO timestamp, optional)"
    },
    "api_endpoint": "/api/captain/documents",
    "supported_operations": [
      "Single field upload (idFront, idBack, captainLicense, etc.)",
      "Additional document upload/removal",
      "Banking information update",
      "Full snapshot replacement"
    ],
    "note": "All documents stored via Vercel Blob with public URLs; no PendingMedia model needed"
  },
