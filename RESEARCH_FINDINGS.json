  "system_message_generation_strategy": {
    "approach": "Multi-check system on page load",
    "checks": [
      {
        "check": "Verification Status",
        "query": "prisma.captainVerification.findUnique({ where: { userId } })",
        "fields_to_check": [
          "status (PENDING/APPROVED/REJECTED)",
          "idFront, idBack (presence)",
          "bankAccountNumber (presence)"
        ]
      },
      {
        "check": "Charter Status",
        "query": "Get all charters for user",
        "fields_to_check": [
          "isLocked",
          "media.length === 0",
          "trips.length === 0"
        ]
      },
      {
        "check": "Payout Status",
        "query": "prisma.payout.findMany({ where: { ownerId: userId, status: 'PENDING' } })",
        "fields_to_check": ["Unpaid earnings", "Pending payouts"]
      },
      {
        "check": "Document Expiry",
        "logic": "Parse metadata from captainVerification documents",
        "fields_to_check": ["License renewal dates", "Banking info age"]
      }
    ],
    "priority_ranking": [
      "CRITICAL: account locked, verification rejected, missing mandatory docs",
      "HIGH: incomplete verification, no banking info, charter locked",
      "MEDIUM: missing optional docs, expiring soon, payout issues",
      "LOW: informational announcements"
    ]
  },
